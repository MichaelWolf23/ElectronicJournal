<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ElectronicJournal.App"
             xmlns:local="using:ElectronicJournal"
             xmlns:utilities="using:ElectronicJournal.Utilities"
             xmlns:media="using:Avalonia.Media"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <utilities:GradeBrushConverter x:Key="GradeBrushConverter"/>
            <utilities:StatusBrushConverter x:Key="StatusBrushConverter"/>
            <utilities:NotificationBrushConverter x:Key="NotificationBrushConverter"/>
            <utilities:BooleanStatusTextConverter x:Key="BooleanStatusTextConverter"/>
            <utilities:BooleanStatusForegroundConverter x:Key="BooleanStatusForegroundConverter"/>
            <utilities:BooleanStatusBackgroundConverter x:Key="BooleanStatusBackgroundConverter"/>
            <utilities:WidthThresholdConverter x:Key="WideTableConverter" Threshold="760"/>
            <utilities:WidthThresholdConverter x:Key="CompactTableConverter" Threshold="760" IsLessThan="True"/>
            <utilities:WidthThresholdConverter x:Key="WideLessonJournalConverter" Threshold="1080"/>
            <utilities:WidthThresholdConverter x:Key="CompactLessonJournalConverter" Threshold="1080" IsLessThan="True"/>
            <utilities:WidthThresholdConverter x:Key="WideRetakesConverter" Threshold="1020"/>
            <utilities:WidthThresholdConverter x:Key="CompactRetakesConverter" Threshold="1020" IsLessThan="True"/>
            <utilities:WidthThresholdConverter x:Key="WideReportsConverter" Threshold="1080"/>
            <utilities:WidthThresholdConverter x:Key="CompactReportsConverter" Threshold="1080" IsLessThan="True"/>
            <utilities:WidthThresholdConverter x:Key="WideDashboardConverter" Threshold="980"/>
            <utilities:WidthThresholdConverter x:Key="CompactDashboardConverter" Threshold="980" IsLessThan="True"/>
            <utilities:NumberStateConverter x:Key="HasDataConverter"/>
            <utilities:NumberStateConverter x:Key="NoDataConverter" IsZero="True"/>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <media:SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFBFC"/>
                    <media:SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
                    <media:SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF"/>
                    <media:SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#F3F6FA"/>
                    <media:SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
                    <media:SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#EAF2FF"/>
                    <media:SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F1F5F9"/>
                    <media:SolidColorBrush x:Key="PillBackgroundBrush" Color="#EEF4FF"/>
                    <media:SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
                    <media:SolidColorBrush x:Key="BorderThemeBrush" Color="#E6EAF0"/>
                    <media:SolidColorBrush x:Key="StrongBorderBrush" Color="#D4DCE7"/>
                    <media:SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A"/>
                    <media:SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569"/>
                    <media:SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
                    <media:SolidColorBrush x:Key="AccentThemeBrush" Color="#2563EB"/>
                    <media:SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
                    <media:SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF"/>
                    <media:SolidColorBrush x:Key="SuccessThemeBrush" Color="#16803C"/>
                    <media:SolidColorBrush x:Key="SuccessSoftBrush" Color="#E9F8EF"/>
                    <media:SolidColorBrush x:Key="SuccessHoverBrush" Color="#DDF4E6"/>
                    <media:SolidColorBrush x:Key="WarningThemeBrush" Color="#B45309"/>
                    <media:SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF7ED"/>
                    <media:SolidColorBrush x:Key="WarningHoverBrush" Color="#FFEDD5"/>
                    <media:SolidColorBrush x:Key="DangerThemeBrush" Color="#DC2626"/>
                    <media:SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2"/>
                    <media:SolidColorBrush x:Key="DangerHoverBrush" Color="#FEE2E2"/>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <media:SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1120"/>
                    <media:SolidColorBrush x:Key="CardBackgroundBrush" Color="#111827"/>
                    <media:SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A"/>
                    <media:SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#172033"/>
                    <media:SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0F172A"/>
                    <media:SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#1E3A5F"/>
                    <media:SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1E293B"/>
                    <media:SolidColorBrush x:Key="PillBackgroundBrush" Color="#172554"/>
                    <media:SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
                    <media:SolidColorBrush x:Key="BorderThemeBrush" Color="#263244"/>
                    <media:SolidColorBrush x:Key="StrongBorderBrush" Color="#334155"/>
                    <media:SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC"/>
                    <media:SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1"/>
                    <media:SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>
                    <media:SolidColorBrush x:Key="AccentThemeBrush" Color="#60A5FA"/>
                    <media:SolidColorBrush x:Key="AccentHoverBrush" Color="#3B82F6"/>
                    <media:SolidColorBrush x:Key="AccentSoftBrush" Color="#172554"/>
                    <media:SolidColorBrush x:Key="SuccessThemeBrush" Color="#7EE787"/>
                    <media:SolidColorBrush x:Key="SuccessSoftBrush" Color="#173B26"/>
                    <media:SolidColorBrush x:Key="SuccessHoverBrush" Color="#1E4A30"/>
                    <media:SolidColorBrush x:Key="WarningThemeBrush" Color="#D29922"/>
                    <media:SolidColorBrush x:Key="WarningSoftBrush" Color="#3D3214"/>
                    <media:SolidColorBrush x:Key="WarningHoverBrush" Color="#4B3B16"/>
                    <media:SolidColorBrush x:Key="DangerThemeBrush" Color="#FF8A8A"/>
                    <media:SolidColorBrush x:Key="DangerSoftBrush" Color="#472020"/>
                    <media:SolidColorBrush x:Key="DangerHoverBrush" Color="#5A2525"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentThemeBrush}"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.86"/>
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentThemeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentThemeBrush}"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.success">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessThemeBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessThemeBrush}"/>
        </Style>

        <Style Selector="Button.success:pointerover">
            <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessThemeBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessThemeBrush}"/>
        </Style>

        <Style Selector="Button.success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SuccessHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessThemeBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource SuccessThemeBrush}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerThemeBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerThemeBrush}"/>
        </Style>

        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerThemeBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerThemeBrush}"/>
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerThemeBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource DangerThemeBrush}"/>
        </Style>

        <Style Selector="Button.warning">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarningThemeBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningThemeBrush}"/>
        </Style>

        <Style Selector="Button.warning:pointerover">
            <Setter Property="Background" Value="{DynamicResource WarningHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WarningThemeBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningThemeBrush}"/>
        </Style>

        <Style Selector="Button.warning:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WarningHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningThemeBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource WarningThemeBrush}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
        </Style>

        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentThemeBrush}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentThemeBrush}"/>
        </Style>

        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
        </Style>

        <Style Selector="Border.section-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style Selector="Border.section-panel:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
        </Style>

        <Style Selector="Border.toolbar-panel">
            <Setter Property="Background" Value="{DynamicResource SubtleBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Border.side-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="Border.list-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style Selector="Border.list-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>

        <Style Selector="Border.metric-panel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderThemeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Border.status-pill">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
        </Style>
    </Application.Styles>
</Application>
