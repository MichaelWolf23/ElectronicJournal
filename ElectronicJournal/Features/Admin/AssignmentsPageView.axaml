<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             x:Class="ElectronicJournal.Views.AssignmentsPageView"
             x:Name="Root"
             x:DataType="vm:AssignmentsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Classes="toolbar-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Назначения" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Обновить"
                            Classes="ghost"
                            Command="{Binding LoadCommand}"/>
                </Grid>
                <TextBox Grid.Row="1"
                         Watermark="Поиск по преподавателю, куратору, группе, предмету или периоду"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
            <UniformGrid Columns="2">
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding TeacherAssignmentCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="преподавательских назначений" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding CuratorAssignmentCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                    <TextBlock Text="кураторских назначений" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2" x:Name="AssignmentsHost">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="14"
                  IsVisible="{Binding #AssignmentsHost.Bounds.Width, Converter={StaticResource WideDashboardConverter}}">
                <Border Classes="section-panel">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Преподаватели" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Кто ведет предмет у группы в выбранный период."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TeacherAssignmentCount, StringFormat='{}{0} записей'}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding TeacherAssignments}"
                                 SelectedItem="{Binding SelectedTeacherAssignment}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:TeacherAssignmentItem">
                                    <Border Classes="list-row">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="10">
                                            <TextBlock Text="{Binding TeacherName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GroupName}" Foreground="{DynamicResource AccentThemeBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Text="{Binding SubjectName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="{Binding PeriodName}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2"
                                Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Text="Назначить преподавателя" FontWeight="SemiBold"/>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding Teachers}"
                                              SelectedValue="{Binding SelectedTeacherId}"
                                              SelectedValueBinding="{Binding Id}"
                                              PlaceholderText="Преподаватель">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:LookupItem">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Groups}"
                                              SelectedValue="{Binding SelectedTeacherGroupId}"
                                              SelectedValueBinding="{Binding GroupId}"
                                              PlaceholderText="Группа">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="entities:Group">
                                                <TextBlock Text="{Binding GroupName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding Subjects}"
                                              SelectedValue="{Binding SelectedSubjectId}"
                                              SelectedValueBinding="{Binding SubjectId}"
                                              PlaceholderText="Предмет">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="entities:Subject">
                                                <TextBlock Text="{Binding SubjectName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Periods}"
                                              SelectedValue="{Binding SelectedPeriodId}"
                                              SelectedValueBinding="{Binding Id}"
                                              PlaceholderText="Период">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:LookupItem">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Назначить" Classes="primary" Command="{Binding AddTeacherAssignmentCommand}"/>
                                    <Button Grid.Column="3" Content="Удалить" Classes="danger" Command="{Binding DeleteTeacherAssignmentCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="section-panel">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Кураторы групп" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Кто отвечает за сопровождение группы."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CuratorAssignmentCount, StringFormat='{}{0} записей'}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CuratorAssignments}"
                                 SelectedItem="{Binding SelectedCuratorAssignment}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:GroupCuratorItem">
                                    <Border Classes="list-row">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="10">
                                            <TextBlock Text="{Binding CuratorName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding GroupName}" Foreground="{DynamicResource AccentThemeBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Text="{Binding AssignedAt}" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2"
                                Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBlock Text="Назначить куратора" FontWeight="SemiBold"/>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox ItemsSource="{Binding Curators}"
                                              SelectedValue="{Binding SelectedCuratorId}"
                                              SelectedValueBinding="{Binding Id}"
                                              PlaceholderText="Куратор">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:LookupItem">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Groups}"
                                              SelectedValue="{Binding SelectedCuratorGroupId}"
                                              SelectedValueBinding="{Binding GroupId}"
                                              PlaceholderText="Группа">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="entities:Group">
                                                <TextBlock Text="{Binding GroupName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="Назначить" Classes="primary" Command="{Binding AddCuratorAssignmentCommand}"/>
                                    <Button Grid.Column="3" Content="Удалить" Classes="danger" Command="{Binding DeleteCuratorAssignmentCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding #AssignmentsHost.Bounds.Width, Converter={StaticResource CompactDashboardConverter}}">
                <StackPanel Spacing="14">
                    <Border Classes="section-panel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="Преподаватели" FontSize="18" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TeacherAssignments}" SelectedItem="{Binding SelectedTeacherAssignment}"/>
                        </Grid>
                    </Border>
                    <Border Classes="section-panel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="Кураторы групп" FontSize="18" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding CuratorAssignments}" SelectedItem="{Binding SelectedCuratorAssignment}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
