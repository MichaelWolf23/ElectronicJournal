<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             x:Class="ElectronicJournal.Views.AssignmentsPageView"
             x:Name="Root"
             x:DataType="vm:AssignmentsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="toolbar-panel">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3">
                <TextBlock Text="Назначения" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerThemeBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <TextBox Grid.Column="1"
                     Width="260"
                     Watermark="Поиск"
                     Text="{Binding SearchText}"/>
            <Button Grid.Column="2"
                    Content="Обновить"
                    Classes="ghost"
                    Command="{Binding LoadCommand}"/>
        </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Преподавательских назначений:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding TeacherAssignmentCount}" FontWeight="SemiBold" Foreground="{DynamicResource AccentThemeBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Кураторских назначений:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding CuratorAssignmentCount}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessThemeBrush}"/>
            </StackPanel>
        </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="section-panel">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Преподаватели" FontSize="16" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TeacherAssignments}"
                          SelectedItem="{Binding SelectedTeacherAssignment}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="*"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="95"/>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="160"/>
                        <DataGridTextColumn Header="Период" Binding="{Binding PeriodName}" Width="155"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <ComboBox ItemsSource="{Binding Teachers}"
                                  SelectedValue="{Binding SelectedTeacherId}"
                                  SelectedValueBinding="{Binding Id}"
                                  PlaceholderText="Преподаватель">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:LookupItem">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Groups}"
                                  SelectedValue="{Binding SelectedTeacherGroupId}"
                                  SelectedValueBinding="{Binding GroupId}"
                                  PlaceholderText="Группа">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:Group">
                                    <TextBlock Text="{Binding GroupName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                        <ComboBox ItemsSource="{Binding Subjects}"
                                  SelectedValue="{Binding SelectedSubjectId}"
                                  SelectedValueBinding="{Binding SubjectId}"
                                  PlaceholderText="Предмет">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="entities:Subject">
                                    <TextBlock Text="{Binding SubjectName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Periods}"
                                  SelectedValue="{Binding SelectedPeriodId}"
                                  SelectedValueBinding="{Binding Id}"
                                  PlaceholderText="Период">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:LookupItem">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2"
                                Content="Назначить"
                                Classes="primary"
                                Command="{Binding AddTeacherAssignmentCommand}"/>
                        <Button Grid.Column="3"
                                Content="Удалить"
                                Classes="danger"
                                Command="{Binding DeleteTeacherAssignmentCommand}"/>
                    </Grid>
                </Grid>
            </Grid>
            </Border>

            <Border Grid.Column="1" Classes="section-panel">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Кураторы групп" FontSize="16" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding CuratorAssignments}"
                          SelectedItem="{Binding SelectedCuratorAssignment}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120"/>
                        <DataGridTextColumn Header="Куратор" Binding="{Binding CuratorName}" Width="*"/>
                        <DataGridTextColumn Header="Назначен" Binding="{Binding AssignedAt}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                    <ComboBox ItemsSource="{Binding Curators}"
                              SelectedValue="{Binding SelectedCuratorId}"
                              SelectedValueBinding="{Binding Id}"
                              PlaceholderText="Куратор">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Groups}"
                              SelectedValue="{Binding SelectedCuratorGroupId}"
                              SelectedValueBinding="{Binding GroupId}"
                              PlaceholderText="Группа">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Group">
                                <TextBlock Text="{Binding GroupName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2"
                            Content="Назначить"
                            Classes="primary"
                            Command="{Binding AddCuratorAssignmentCommand}"/>
                    <Button Grid.Column="3"
                            Content="Удалить"
                            Classes="danger"
                            Command="{Binding DeleteCuratorAssignmentCommand}"/>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
