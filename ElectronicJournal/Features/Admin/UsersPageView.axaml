<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             x:Class="ElectronicJournal.Views.UsersPageView"
             x:Name="Root"
             x:DataType="vm:UsersPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Classes="toolbar-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Пользователи" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Обновить"
                            Classes="ghost"
                            Command="{Binding LoadCommand}"/>
                </Grid>
                <TextBox Grid.Row="1"
                         Watermark="Поиск по ФИО, логину, роли, email или телефону"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
            <UniformGrid Columns="4">
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding RegistrationRequestCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                    <TextBlock Text="заявок" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding UserCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="учетных записей" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding ActiveUserCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                    <TextBlock Text="активны" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding InactiveUserCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="отключены" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2" x:Name="UsersHost">
            <Grid ColumnDefinitions="*,360"
                  ColumnSpacing="14"
                  IsVisible="{Binding #UsersHost.Bounds.Width, Converter={StaticResource WideDashboardConverter}}">
                <TabControl>
                    <TabItem Header="Заявки">
                        <Border Classes="section-panel" Margin="0,10,0,0">
                            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Заявки на регистрацию" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Новый пользователь получает доступ только после активации."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="Нет заявок"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               IsVisible="{Binding RegistrationRequestCount, Converter={StaticResource NoDataConverter}}"/>
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding RegistrationRequests}"
                                         SelectedItem="{Binding SelectedRegistrationRequest}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="dto:UserListItem">
                                            <Border Classes="list-row">
                                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="{DynamicResource AccentThemeBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Email}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedAt}" Foreground="{DynamicResource MutedTextBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Учетные записи">
                        <Border Classes="section-panel" Margin="0,10,0,0">
                            <Grid x:Name="UsersListHost" RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Учетные записи" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Выберите пользователя для редактирования справа."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UserCount, StringFormat='{}{0} записей'}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <DataGrid MinWidth="640"
                                              ItemsSource="{Binding Users}"
                                              SelectedItem="{Binding SelectedUser}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              GridLinesVisibility="Horizontal"
                                              IsVisible="{Binding #UsersListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="230"/>
                                            <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="120"/>
                                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="140"/>
                                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <ListBox ItemsSource="{Binding Users}"
                                             SelectedItem="{Binding SelectedUser}"
                                             IsVisible="{Binding #UsersListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:UserListItem">
                                                <Border Classes="list-row">
                                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding RoleName}" Foreground="{DynamicResource AccentThemeBrush}"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Username}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IsActive}" Foreground="{DynamicResource MutedTextBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Background="{DynamicResource SubtleBackgroundBrush}"
                                            IsVisible="{Binding UserCount, Converter={StaticResource NoDataConverter}}">
                                        <TextBlock Text="Нет пользователей" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <Border Grid.Column="1" Classes="section-panel">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Обработка заявки" FontSize="18" FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource SubtleBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderThemeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{Binding SelectedRequestTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedRequestDetails}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <ComboBox ItemsSource="{Binding Roles}"
                                          SelectedValue="{Binding SelectedRoleId}"
                                          SelectedValueBinding="{Binding RoleId}"
                                          PlaceholderText="Назначить роль"
                                          IsEnabled="{Binding HasSelectedRegistrationRequest}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Role">
                                            <TextBlock Text="{Binding RoleName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Content="Активировать" Classes="success" Command="{Binding ActivateRegistrationRequestCommand}" IsEnabled="{Binding HasSelectedRegistrationRequest}"/>
                                    <Button Grid.Column="1" Content="Отклонить" Classes="danger" Command="{Binding RejectRegistrationRequestCommand}" IsEnabled="{Binding HasSelectedRegistrationRequest}"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderThemeBrush}"/>

                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedUserDetails}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding SelectedRoleId}" SelectedValueBinding="{Binding RoleId}" PlaceholderText="Роль">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Role">
                                            <TextBlock Text="{Binding RoleName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Watermark="ФИО" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Watermark="Логин" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Watermark="Новый пароль" PasswordChar="*" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Watermark="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Watermark="Телефон" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="Пользователь активен" IsChecked="{Binding IsActive}"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Content="Сохранить" Classes="primary" Command="{Binding SaveCommand}"/>
                                    <Button Grid.Column="1" Content="Очистить" Classes="ghost" Command="{Binding ClearFormCommand}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Content="Вкл / выкл" Classes="warning" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding HasSelectedUser}"/>
                                    <Button Grid.Column="1" Content="Удалить" Classes="danger" Command="{Binding DeleteSelectedUserCommand}" IsEnabled="{Binding HasSelectedUser}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding #UsersHost.Bounds.Width, Converter={StaticResource CompactDashboardConverter}}">
                <TabControl>
                    <TabItem Header="Заявки">
                        <Border Classes="section-panel" Margin="0,10,0,0">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Заявки на регистрацию" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Новые аккаунты без доступа."
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RegistrationRequestCount, StringFormat='{}{0}'}"
                                               Foreground="{DynamicResource WarningThemeBrush}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <ListBox MaxHeight="360"
                                             ItemsSource="{Binding RegistrationRequests}"
                                             SelectedItem="{Binding SelectedRegistrationRequest}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:UserListItem">
                                                <Border Classes="list-row">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <Border Grid.Column="1"
                                                                    Classes="status-pill"
                                                                    Background="{DynamicResource WarningSoftBrush}">
                                                                <TextBlock Text="заявка"
                                                                           Foreground="{DynamicResource WarningThemeBrush}"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Username, StringFormat='{}Логин: {0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding Email}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Background="{DynamicResource SubtleBackgroundBrush}"
                                            MinHeight="140"
                                            IsVisible="{Binding RegistrationRequestCount, Converter={StaticResource NoDataConverter}}">
                                        <TextBlock Text="Нет заявок"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderThemeBrush}"/>

                                <ComboBox ItemsSource="{Binding Roles}"
                                          SelectedValue="{Binding SelectedRoleId}"
                                          SelectedValueBinding="{Binding RoleId}"
                                          PlaceholderText="Роль для активации"
                                          IsEnabled="{Binding HasSelectedRegistrationRequest}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Role">
                                            <TextBlock Text="{Binding RoleName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Content="Активировать"
                                            Classes="success"
                                            Command="{Binding ActivateRegistrationRequestCommand}"
                                            IsEnabled="{Binding HasSelectedRegistrationRequest}"/>
                                    <Button Grid.Column="1"
                                            Content="Отклонить"
                                            Classes="danger"
                                            Command="{Binding RejectRegistrationRequestCommand}"
                                            IsEnabled="{Binding HasSelectedRegistrationRequest}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Учетные записи">
                        <StackPanel Spacing="14" Margin="0,10,0,0">
                            <Border Classes="section-panel">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Учетные записи" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Выберите пользователя для редактирования."
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UserCount, StringFormat='{}{0}'}"
                                                   Foreground="{DynamicResource AccentThemeBrush}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ListBox MaxHeight="360" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="dto:UserListItem">
                                                <Border Classes="list-row">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding FullName}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding RoleName}"
                                                                       Foreground="{DynamicResource AccentThemeBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                        </Grid>
                                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding Username, StringFormat='{}Логин: {0}'}"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <Border Grid.Column="1"
                                                                    Classes="status-pill"
                                                                    Background="{Binding IsActive, Converter={StaticResource BooleanStatusBackgroundConverter}}">
                                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanStatusTextConverter}}"
                                                                           Foreground="{Binding IsActive, Converter={StaticResource BooleanStatusForegroundConverter}}"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding Email}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="section-panel">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedUserDetails}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{Binding Roles}"
                                              SelectedValue="{Binding SelectedRoleId}"
                                              SelectedValueBinding="{Binding RoleId}"
                                              PlaceholderText="Роль">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="entities:Role">
                                                <TextBlock Text="{Binding RoleName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Watermark="ФИО" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Watermark="Логин" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Watermark="Новый пароль" PasswordChar="*" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Watermark="Email" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Watermark="Телефон" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="Пользователь активен" IsChecked="{Binding IsActive}"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Content="Сохранить" Classes="primary" Command="{Binding SaveCommand}"/>
                                        <Button Grid.Column="1" Content="Очистить" Classes="ghost" Command="{Binding ClearFormCommand}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Content="Вкл / выкл" Classes="warning" Command="{Binding ToggleActiveCommand}" IsEnabled="{Binding HasSelectedUser}"/>
                                        <Button Grid.Column="1" Content="Удалить" Classes="danger" Command="{Binding DeleteSelectedUserCommand}" IsEnabled="{Binding HasSelectedUser}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
