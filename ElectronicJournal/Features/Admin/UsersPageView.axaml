<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             x:Class="ElectronicJournal.Views.UsersPageView"
             x:DataType="vm:UsersPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
            <Grid ColumnDefinitions="*,150" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="Управление пользователями" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Обновить" Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Всего" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding UserCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Активные" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ActiveUserCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Отключены" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding InactiveUserCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="300,*"
              ColumnSpacing="10">
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="10,8,10,6" Spacing="2">
                        <TextBlock Text="Учетные записи" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="90"/>
                            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Padding="12"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerThemeBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedValue="{Binding SelectedRoleId}"
                              SelectedValueBinding="{Binding RoleId}"
                              PlaceholderText="Роль">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Role">
                                <TextBlock Text="{Binding RoleName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Watermark="ФИО"
                             Text="{Binding FullName}"/>
                    <TextBox Watermark="Логин"
                             Text="{Binding Username}"/>
                    <TextBox Watermark="Новый пароль"
                             PasswordChar="*"
                             Text="{Binding Password}"/>
                    <TextBox Watermark="Email"
                             Text="{Binding Email}"/>
                    <TextBox Watermark="Телефон"
                             Text="{Binding Phone}"/>
                    <CheckBox Content="Пользователь активен"
                              IsChecked="{Binding IsActive}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Content="Сохранить"
                                Command="{Binding SaveCommand}"/>
                        <Button Grid.Column="1"
                                Content="Очистить"
                                Command="{Binding ClearFormCommand}"/>
                    </Grid>

                    <Button Content="Включить / отключить"
                            Command="{Binding ToggleActiveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
