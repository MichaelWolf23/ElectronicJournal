<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderThemeBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding WorkdayTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Greeting}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="8,5"
                        CornerRadius="6"
                        Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding RoleText}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="2*,*"
              ColumnSpacing="10">
            <Border Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding PrimaryScenarioTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PrimaryScenarioText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PriorityItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:DashboardWorkItem">
                                <Button Command="{Binding OpenCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,8,0"
                                        Padding="0"
                                        Background="{DynamicResource SubtleBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderThemeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Border Padding="10" MinHeight="98">
                                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                            <TextBlock Text="{Binding Badge}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentThemeBrush}"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Title}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Description}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="Показатели"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:DashboardMetricItem">
                                <Border Padding="8"
                                        Margin="0,0,0,6"
                                        CornerRadius="7"
                                        Background="{DynamicResource SubtleBackgroundBrush}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Text="{Binding Value}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentThemeBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="10">
            <Border Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="{Binding AttentionTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding AttentionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:DashboardWorkItem">
                                <Button Command="{Binding OpenCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,7"
                                        Padding="0"
                                        Background="{DynamicResource SubtleBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderThemeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid Margin="10"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Padding="7,4"
                                                CornerRadius="6"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentThemeBrush}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="Разделы для работы"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:DashboardActionItem">
                                <Button Command="{Binding OpenCommand}"
                                        HorizontalContentAlignment="Stretch"
                                        Margin="0,0,0,7"
                                        Padding="9"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderThemeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Text=">"
                                                   Foreground="{DynamicResource AccentThemeBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
