<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.DashboardPageView"
             x:DataType="vm:DashboardPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding WorkdayTitle}"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Greeting}"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PrimaryScenarioText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="300"
                    Padding="16"
                    CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding RoleText}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="{Binding PrimaryScenarioTitle}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="0,14"
                BorderBrush="{DynamicResource BorderThemeBrush}"
                BorderThickness="0,1,0,1">
            <ItemsControl ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="dto:DashboardMetricItem">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              Margin="0,0,20,0">
                            <TextBlock Text="{Binding Value}"
                                       VerticalAlignment="Center"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentThemeBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="1.25*,1.05*,0.8*"
              ColumnSpacing="28">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Что сделать сейчас"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ItemsControl Grid.Row="1"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding PriorityItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:DashboardWorkItem">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,4"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid MinHeight="58"
                                      ColumnDefinitions="76,*,24"
                                      ColumnSpacing="14">
                                    <Border Width="58"
                                            Height="28"
                                            CornerRadius="14"
                                            Background="{DynamicResource PillBackgroundBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentThemeBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text=">"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentThemeBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*">
                <TextBlock Text="{Binding AttentionTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ItemsControl Grid.Row="1"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding AttentionItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:DashboardWorkItem">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,4"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid MinHeight="56"
                                      ColumnDefinitions="*,78,24"
                                      ColumnSpacing="12">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Badge}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentThemeBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2"
                                               Text=">"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentThemeBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*">
                <TextBlock Text="Разделы"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ItemsControl Grid.Row="1"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:DashboardActionItem">
                            <Button Command="{Binding OpenCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,4"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Grid MinHeight="42"
                                      ColumnDefinitions="*,24">
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text=">"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentThemeBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
