<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElectronicJournal.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="ElectronicJournal.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Электронный журнал"
        Width="1200"
        Height="750"
        MinWidth="820"
        MinHeight="560">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="{Binding SidebarWidth}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="14,14,14,12"
                          ColumnDefinitions="*,40"
                          ColumnSpacing="8"
                          MinHeight="42">
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1"
                                    IsVisible="{Binding IsSidebarExpanded}">
                            <TextBlock Text="Электронный журнал"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentPeriodName, StringFormat=Период: {0}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="36"
                                Height="34"
                                Classes="ghost"
                                Content="{Binding SidebarToggleText}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="Свернуть или развернуть меню"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="8,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationItem">
                                    <Grid Height="40"
                                          Margin="2,1"
                                          ToolTip.Tip="{Binding Title}">
                                        <Grid ColumnDefinitions="44,*"
                                              ColumnSpacing="8">
                                            <Border Width="32"
                                                    Height="28"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent">
                                                <PathIcon Data="{Binding IconGeometry}"
                                                          Width="18"
                                                          Height="18"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="1"
                                                        IsVisible="{Binding $parent[Window].DataContext.IsSidebarExpanded}">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Margin="14,12,14,14"
                            Padding="0,12,0,0"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="10">
                            <StackPanel Spacing="1"
                                        IsVisible="{Binding IsSidebarExpanded}">
                                <TextBlock Text="{Binding CurrentUserName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentUserRole}"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding IsSidebarExpanded}">
                                <Button Content="{Binding ThemeButtonText}"
                                        Classes="ghost"
                                        Command="{Binding ToggleThemeCommand}"/>
                                <Button Grid.Column="1"
                                        Content="Выйти"
                                        Classes="danger"
                                        Command="{Binding LogoutCommand}"/>
                            </Grid>
                            <StackPanel Grid.Row="1"
                                        Spacing="8"
                                        IsVisible="{Binding IsSidebarCollapsed}">
                                <Button Content="&#xE706;"
                                        Classes="ghost"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding ToggleThemeCommand}"
                                        ToolTip.Tip="{Binding ThemeButtonText}"/>
                                <Button Content="&#xE8AC;"
                                        Classes="danger"
                                        FontFamily="Segoe MDL2 Assets"
                                        Command="{Binding LogoutCommand}"
                                        ToolTip.Tip="Выйти"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  RowDefinitions="56,*">
                <Border Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderThemeBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding SelectedNavigationItem.Title}"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{DynamicResource SuccessThemeBrush}"/>
                            <TextBlock Text="База данных"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="24,20">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
