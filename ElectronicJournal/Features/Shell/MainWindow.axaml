<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:ElectronicJournal.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
		x:Class="ElectronicJournal.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/avalonia-logo.ico"
		Title="Электронный журнал"
		Width="1200"
		Height="750"
		MinWidth="820"
		MinHeight="560">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid Background="{DynamicResource AppBackgroundBrush}"
		  ColumnDefinitions="248,*">
		<Border Background="{DynamicResource SidebarBackgroundBrush}"
				BorderBrush="{DynamicResource BorderThemeBrush}"
				BorderThickness="0,0,1,0">
			<Grid RowDefinitions="Auto,*,Auto">
				<StackPanel Grid.Column="0" Margin="18,18,18,16"
							VerticalAlignment="Center"
							Spacing="1">
					<TextBlock Text="Электронный журнал"
							   FontSize="16"
							   FontWeight="SemiBold"/>
					<TextBlock Text="{Binding CurrentPeriodName, StringFormat=Период: {0}}"
							   FontSize="12"
							   Foreground="{DynamicResource MutedTextBrush}"
							   TextTrimming="CharacterEllipsis"/>
				</StackPanel>


				<ScrollViewer Grid.Row="1"
							  Margin="10,0"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<ListBox ItemsSource="{Binding NavigationItems}"
							 SelectedItem="{Binding SelectedNavigationItem}">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="vm:NavigationItem">
								<Grid Height="38"
									  Margin="3,1">
									<StackPanel VerticalAlignment="Center"
												Margin="14,0,8,0"
												Spacing="1">
										<TextBlock Text="{Binding Title}"
												   FontSize="13"
												   FontWeight="SemiBold"
												   TextTrimming="CharacterEllipsis"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</ScrollViewer>

				<Border Grid.Row="2"
						Margin="18,12,18,18"
						Padding="0,14,0,0"
						BorderBrush="{DynamicResource BorderThemeBrush}"
						BorderThickness="0,1,0,0">
					<Grid RowDefinitions="Auto,Auto"
						  RowSpacing="10">
						<StackPanel Spacing="1">
							<TextBlock Text="{Binding CurrentUserName}"
									   FontWeight="SemiBold"
									   TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding CurrentUserRole}"
									   FontSize="12"
									   Foreground="{DynamicResource SecondaryTextBrush}"
									   TextTrimming="CharacterEllipsis"/>
						</StackPanel>
						<Grid Grid.Row="1"
							  ColumnDefinitions="*,Auto"
							  ColumnSpacing="8">
							<Button Content="{Binding ThemeButtonText}"
									Command="{Binding ToggleThemeCommand}"/>
							<Button Grid.Column="1"
									Content="Выйти"
									Command="{Binding LogoutCommand}"/>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Border>

		<Grid Grid.Column="1"
			  RowDefinitions="56,*">
			<Border Background="{DynamicResource HeaderBackgroundBrush}"
					BorderBrush="{DynamicResource BorderThemeBrush}"
					BorderThickness="0,0,0,1"
					Padding="24,0">
				<Grid ColumnDefinitions="*,Auto"
					  ColumnSpacing="16">
					<StackPanel VerticalAlignment="Center"
								Spacing="1">
						<TextBlock Text="{Binding SelectedNavigationItem.Title}"
								   FontSize="22"
								   FontWeight="SemiBold"/>
					</StackPanel>
					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								Spacing="8"
								VerticalAlignment="Center">
						<Border Width="8"
								Height="8"
								CornerRadius="4"
								Background="{DynamicResource SuccessThemeBrush}"/>
						<TextBlock Text="База данных"
								   Foreground="{DynamicResource SecondaryTextBrush}"
								   VerticalAlignment="Center"/>
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="1"
					Padding="24,20">
				<ContentControl Content="{Binding CurrentPage}"/>
			</Border>
		</Grid>
	</Grid>
</Window>
