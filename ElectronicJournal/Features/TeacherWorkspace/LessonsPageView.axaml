<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.LessonsPageView"
             x:Name="Root"
             x:DataType="vm:LessonsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="toolbar-panel">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBox Width="280"
                     Watermark="Поиск по теме, группе, предмету"
                     Text="{Binding SearchText}"/>
            <ComboBox Grid.Column="1"
                      Width="170"
                      ItemsSource="{Binding ScheduleDayFilters}"
                      SelectedItem="{Binding SelectedScheduleDayFilter}"/>
            <Button Grid.Column="2"
                    Content="Обновить"
                    Classes="ghost"
                    Command="{Binding LoadCommand}"/>
        </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Classes="metric-panel">
                <StackPanel Spacing="4">
                    <TextBlock Text="Занятий" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding LessonCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="metric-panel">
                <StackPanel Spacing="4">
                    <TextBlock Text="В расписании" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ScheduleCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="metric-panel">
                <StackPanel Spacing="4">
                    <TextBlock Text="Назначений" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AssignmentCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="12">
        <Border Grid.Column="1" Classes="section-panel">
        <TabControl>
            <TabItem Header="Занятия">
                <Border>
                    <Grid x:Name="LessonsListHost" RowDefinitions="Auto,*">
                        <StackPanel Margin="0,0,0,10" Spacing="2">
                            <TextBlock Text="Темы занятий" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LessonsSummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  MinWidth="720"
                                  ItemsSource="{Binding Lessons}"
                                  SelectedItem="{Binding SelectedLesson}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  IsVisible="{Binding #LessonsListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding LessonDate}" Width="110"/>
                                <DataGridTextColumn Header="Тема" Binding="{Binding Topic}" Width="250"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120"/>
                                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="180"/>
                                <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomName}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Lessons}"
                                 SelectedItem="{Binding SelectedLesson}"
                                 IsVisible="{Binding #LessonsListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                        <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LessonDate}" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding SubjectName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GroupName}" Foreground="{DynamicResource AccentThemeBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Расписание">
                <Border>
                    <Grid x:Name="ScheduleListHost" RowDefinitions="Auto,*">
                        <StackPanel Margin="0,0,0,10" Spacing="2">
                            <TextBlock Text="Расписание" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Фильтр дня применяется к расписанию, поиск - к расписанию и занятиям."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  MinWidth="720"
                                  ItemsSource="{Binding Schedule}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  IsVisible="{Binding #ScheduleListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="День" Binding="{Binding DayName}" Width="130"/>
                                <DataGridTextColumn Header="Время" Binding="{Binding TimeRange}" Width="110"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120"/>
                                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="180"/>
                                <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="160"/>
                                <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomName}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Schedule}"
                                 IsVisible="{Binding #ScheduleListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                        <TextBlock Text="{Binding SubjectName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GroupName}" Foreground="{DynamicResource AccentThemeBrush}"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding DayName}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="·"/>
                                            <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClassroomName}" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
        </Border>

        <Border Classes="side-panel">
            <StackPanel Spacing="10">
                <TextBlock Text="Занятие" FontSize="16" FontWeight="SemiBold"/>
                <Border Classes="metric-panel">
                    <StackPanel Spacing="7">
                        <TextBlock Text="{Binding SelectedLessonTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedLessonDetails}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedLessonNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Добавить" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding Assignments}"
                          SelectedValue="{Binding SelectedAssignmentId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Группа - предмет - преподаватель">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Watermark="Дата"
                         Text="{Binding LessonDate}"/>

                <ComboBox ItemsSource="{Binding Classrooms}"
                          SelectedValue="{Binding SelectedClassroomId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Аудитория">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Watermark="Тема"
                         Text="{Binding Topic}"/>
                <TextBox Watermark="Примечание"
                         Text="{Binding Note}"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Button Grid.Column="1"
                            Content="Добавить"
                            Classes="primary"
                            Command="{Binding AddLessonCommand}"/>
                    <Button Grid.Column="2"
                            Content="Удалить выбранное"
                            Classes="danger"
                            Command="{Binding DeleteSelectedLessonCommand}"/>
                </Grid>
                <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
