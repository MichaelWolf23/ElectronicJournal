<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.LessonsPageView"
             x:DataType="vm:LessonsPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Занятий" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding LessonCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="В расписании" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ScheduleCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Назначений" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AssignmentCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="10">
        <TabControl Grid.Column="1">
            <TabItem Header="Занятия">
                <Border BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Margin="10,8,10,6" Spacing="2">
                            <TextBlock Text="Темы занятий" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LessonsSummary}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Lessons}"
                                  SelectedItem="{Binding SelectedLesson}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding LessonDate}" Width="110"/>
                                <DataGridTextColumn Header="Тема" Binding="{Binding Topic}" Width="2*"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                                <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                                <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomName}" Width="*"/>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Расписание">
                <Border BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Margin="10,8,10,6" Spacing="2">
                            <TextBlock Text="Расписание" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Schedule}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                                <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                                <DataGridTextColumn Header="День недели" Binding="{Binding DayOfWeek}" Width="110"/>
                                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime}" Width="100"/>
                                <DataGridTextColumn Header="Конец" Binding="{Binding EndTime}" Width="100"/>
                                <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Padding="12" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="Занятие" FontSize="16" FontWeight="SemiBold"/>
                <Border Padding="9" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SubtleBackgroundBrush}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="{Binding SelectedLessonTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedLessonDetails}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedLessonNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Добавить" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding Assignments}"
                          SelectedValue="{Binding SelectedAssignmentId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Группа - предмет - преподаватель">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Watermark="Дата"
                         Text="{Binding LessonDate}"/>

                <ComboBox ItemsSource="{Binding Classrooms}"
                          SelectedValue="{Binding SelectedClassroomId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Аудитория">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Watermark="Тема"
                         Text="{Binding Topic}"/>
                <TextBox Watermark="Примечание"
                         Text="{Binding Note}"/>
                <Button Content="Добавить занятие"
                        Command="{Binding AddLessonCommand}"/>
                <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</UserControl>
