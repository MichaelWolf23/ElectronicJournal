<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.GradesPageView"
             x:Name="Root"
             x:DataType="vm:GradesPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="4">
                <TextBlock Text="Оценивание" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LessonGradeSummary}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Classes="ghost"
                    VerticalAlignment="Top"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Border Grid.Row="1" Classes="toolbar-panel">
            <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding LessonChoices}"
                          SelectedItem="{Binding SelectedLessonForGrading}"
                          PlaceholderText="Занятие">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LessonJournalLessonItem">
                            <Grid RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding Topic}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{Binding LessonDate, StringFormat={}{0}}"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding GradeTypes}"
                          SelectedValue="{Binding SelectedGradeTypeId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Тип оценки">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="Сохранить оценки"
                        Classes="primary"
                        Command="{Binding SaveLessonGradesCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,260" ColumnSpacing="18">
            <Border x:Name="GradeSheetHost" Classes="section-panel">
                <Grid RowDefinitions="Auto,*">
                    <Border Padding="0,0,0,12"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding LessonStudentCount}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentThemeBrush}"/>
                            <TextBlock Text="студентов" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding FilledLessonGradeCount}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessThemeBrush}"/>
                            <TextBlock Text="оценок заполнено" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding AverageGradeText}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningThemeBrush}"/>
                            <TextBlock Text="средний по журналу" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,12,0,0"
                              MinWidth="680"
                              ItemsSource="{Binding GradeEntryRows}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              IsVisible="{Binding #GradeSheetHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Студент" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:GradeEntryRow">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StudentInfo}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Оценка" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:GradeEntryRow">
                                    <TextBox Text="{Binding GradeValueText, Mode=TwoWay}"
                                             Watermark="2-5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Комментарий" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:GradeEntryRow">
                                    <TextBox Text="{Binding Comment, Mode=TwoWay}"
                                             Watermark="Комментарий"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                    </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,0"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleBackgroundBrush}"
                            IsVisible="{Binding LessonStudentCount, Converter={StaticResource NoDataConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="Нет данных" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выберите занятие с группой студентов."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             Margin="0,12,0,0"
                             ItemsSource="{Binding GradeEntryRows}"
                             IsVisible="{Binding #GradeSheetHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:GradeEntryRow">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,90" Margin="0,6" ColumnSpacing="10">
                                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding GradeValueText, Mode=TwoWay}"
                                         Watermark="2-5"/>
                                <TextBlock Grid.Row="1" Text="{Binding StudentInfo}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBox Grid.Row="2" Grid.ColumnSpan="2"
                                         Margin="0,6,0,0"
                                         Text="{Binding Comment, Mode=TwoWay}"
                                         Watermark="Комментарий"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="side-panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Как работать" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Выберите занятие и тип оценки, затем заполните оценки в таблице. Пустые строки не сохраняются."
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LessonGradeResult}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>

                    <Border Padding="0,12,0,0"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="История" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding JournalSummary}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
