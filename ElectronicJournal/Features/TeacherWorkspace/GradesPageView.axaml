<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.GradesPageView"
             x:Name="Root"
             x:DataType="vm:GradesPageViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox Width="210" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroupFilter}" PlaceholderText="Группа">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:Group">
                            <TextBlock Text="{Binding GroupName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Width="230" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubjectFilter}" PlaceholderText="Предмет">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="entities:Subject">
                            <TextBlock Text="{Binding SubjectName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Width="260" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudentFilter}" PlaceholderText="Студент">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:StudentLookupItem">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Сбросить" Command="{Binding ClearFiltersCommand}"/>
                <Button Content="Обновить" Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="0,12" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding VisibleGradeCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="оценок в списке" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding AverageGradeText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="средний балл" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding LowGradeCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerThemeBrush}"/>
                    <TextBlock Text="проблемных оценок" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Журнал оценок" FontSize="18" FontWeight="SemiBold"/>

        <Grid Grid.Row="3" ColumnDefinitions="*,320" ColumnSpacing="18">
            <Grid x:Name="GradesListHost">
                <DataGrid MinWidth="720" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" IsVisible="{Binding #GradesListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="220"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120"/>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="180"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding GradeType}" Width="120"/>
                        <DataGridTemplateColumn Header="Оценка" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GradeValue}" FontWeight="SemiBold" Foreground="{Binding GradeValue, Converter={StaticResource GradeBrushConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        IsVisible="{Binding VisibleGradeCount, Converter={StaticResource NoDataConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="Нет данных" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавьте оценку справа или измените фильтры."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" IsVisible="{Binding #GradesListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding GradeValue}" FontWeight="SemiBold" Foreground="{Binding GradeValue, Converter={StaticResource GradeBrushConverter}}"/>
                                <TextBlock Grid.Row="1" Text="{Binding SubjectName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GradeDate}" Foreground="{DynamicResource MutedTextBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Оценка" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerThemeBrush}" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ComboBox ItemsSource="{Binding Students}" SelectedValue="{Binding SelectedStudentId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Студент">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:StudentLookupItem">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding Assignments}" SelectedValue="{Binding SelectedAssignmentId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Группа - предмет - преподаватель">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding GradeTypes}" SelectedValue="{Binding SelectedGradeTypeId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Тип оценки">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox ItemsSource="{Binding Lessons}" SelectedValue="{Binding SelectedLessonId}" SelectedValueBinding="{Binding Id}" PlaceholderText="Занятие">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Watermark="Оценка" Text="{Binding GradeValue}"/>
                    <TextBox Watermark="Дата" Text="{Binding GradeDate}"/>
                    <TextBox Watermark="Комментарий" Text="{Binding Comment}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Content="Добавить" Command="{Binding AddGradeCommand}"/>
                        <Button Grid.Column="1" Content="Сохранить" Command="{Binding UpdateSelectedGradeCommand}"/>
                    </Grid>
                    <Button Content="Удалить выбранную"
                            Command="{Binding DeleteSelectedGradeCommand}"/>
                    <TextBlock Text="{Binding EditResult}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>

                    <Border Margin="0,8,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding AverageResult}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Средний" Command="{Binding CalculateAverageCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
