<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.FinalGradesPageView"
             x:Name="Root"
             x:DataType="vm:FinalGradesPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="4">
                <TextBlock Text="Итоговые оценки" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Сохранить ведомость"
                    Classes="primary"
                    VerticalAlignment="Top"
                    Command="{Binding SaveSheetCommand}"/>
            <Button Grid.Column="2"
                    Content="Обновить"
                    Classes="ghost"
                    VerticalAlignment="Top"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="12">
            <Border Classes="toolbar-panel">
            <Grid ColumnDefinitions="*,220" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding Assignments}"
                          SelectedValue="{Binding SelectedAssignmentId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Группа — предмет — преподаватель">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Periods}"
                          SelectedValue="{Binding SelectedPeriodId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Период">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            </Border>

            <Border Grid.Row="1"
                    Classes="section-panel">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding SheetStudentCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentThemeBrush}"/>
                        <TextBlock Text="студентов в ведомости"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding SavedSheetCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessThemeBrush}"/>
                        <TextBlock Text="итогов уже сохранено"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding SheetAverageText}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource WarningThemeBrush}"/>
                        <TextBlock Text="средний по ведомости"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" x:Name="FinalSheetHost" Classes="section-panel">
            <Grid>
            <DataGrid MinWidth="780"
                      ItemsSource="{Binding SheetRows}"
                      SelectedItem="{Binding SelectedSheetRow}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      IsVisible="{Binding #FinalSheetHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="260"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="110"/>
                    <DataGridTextColumn Header="Средний" Binding="{Binding AverageText}" Width="100"/>
                    <DataGridTemplateColumn Header="Итог" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="dto:FinalGradeSheetRow">
                                <TextBox Text="{Binding FinalValueText, Mode=TwoWay}"
                                         Watermark="2-5"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Комментарий" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="dto:FinalGradeSheetRow">
                                <TextBox Text="{Binding Comment, Mode=TwoWay}"
                                         Watermark="Комментарий"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource SubtleBackgroundBrush}"
                    IsVisible="{Binding SheetStudentCount, Converter={StaticResource NoDataConverter}}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="Нет данных"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Выберите предмет и период, чтобы открыть ведомость."
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding SheetRows}"
                     SelectedItem="{Binding SelectedSheetRow}"
                     IsVisible="{Binding #FinalSheetHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="dto:FinalGradeSheetRow">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,90" Margin="0,7" ColumnSpacing="10">
                            <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding FinalValueText, Mode=TwoWay}"
                                     Watermark="Итог"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding AverageText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox Grid.Row="2"
                                     Grid.ColumnSpan="2"
                                     Text="{Binding Comment, Mode=TwoWay}"
                                     Watermark="Комментарий"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
