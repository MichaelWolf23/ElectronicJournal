<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.MyLessonsPageView"
             x:DataType="vm:MyLessonsPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="toolbar-panel">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="2">
                    <TextBlock Text="Занятий" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding LessonCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Сегодня" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TodayLessonCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Расписание" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ScheduleCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Classes="ghost"
                    VerticalAlignment="Center"
                    Command="{Binding LoadCommand}"/>
        </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="320,*,280" ColumnSpacing="12">
            <Border Classes="side-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Работа с занятием"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <Border Classes="metric-panel">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding SelectedLessonTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedLessonDetails}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedLessonNote}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Поставить оценки"
                                Classes="primary"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenGradesCommand}"/>
                        <Button Content="Отметить посещаемость"
                                Classes="success"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenAttendanceCommand}"/>
                        <Button Content="Темы и расписание"
                                Classes="ghost"
                                HorizontalAlignment="Stretch"
                                Command="{Binding OpenTopicsCommand}"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerThemeBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Classes="section-panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Margin="0,0,0,8"
                               Text="Мои занятия"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Lessons}"
                             SelectedItem="{Binding SelectedLesson}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LessonListItem">
                                <Border Classes="list-row">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Topic}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1"
                                                    Padding="7,3"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding LessonDate}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentThemeBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding GroupName, StringFormat=Группа: {0}}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SubjectName, StringFormat=Предмет: {0}}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Classes="section-panel">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="Расписание"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ScheduleCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:LessonScheduleCard">
                                <Border Classes="list-row">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding DayName}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TimeRange}"
                                                   Foreground="{DynamicResource AccentThemeBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding GroupName}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SubjectName}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
