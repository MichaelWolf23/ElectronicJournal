<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.AttendancePageView"
             x:Name="Root"
             x:DataType="vm:AttendancePageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Журнал посещаемости" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerThemeBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Classes="ghost"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Border Grid.Row="1" Classes="toolbar-panel">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding Lessons}"
                          SelectedValue="{Binding SelectedLessonId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Выберите занятие">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="1"
                        Content="Отметить всех"
                        Classes="success"
                        Command="{Binding MarkAllPresentCommand}"/>

                <ComboBox Grid.Column="2"
                          Width="180"
                          ItemsSource="{Binding AttendanceStatuses}"
                          SelectedItem="{Binding BulkStatus}"/>

                <Button Grid.Column="3"
                        Content="Применить всем"
                        Classes="warning"
                        Command="{Binding ApplyStatusToAllCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
            <Border Classes="section-panel">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Студентов:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding LessonStudentCount}" FontWeight="SemiBold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Уже сохранено:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding LessonMarkedCount}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="Нет студентов"
                               Foreground="{DynamicResource MutedTextBrush}"
                               IsVisible="{Binding LessonStudentCount, Converter={StaticResource NoDataConverter}}"/>
                    <Button Grid.Column="3"
                            Content="Сохранить журнал"
                            Classes="primary"
                            Command="{Binding SaveLessonAttendanceCommand}"/>
                </Grid>

                <Grid Grid.Row="1" x:Name="LessonMarksHost">
                    <DataGrid ItemsSource="{Binding LessonMarks}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="False"
                              MinWidth="650"
                              IsVisible="{Binding #LessonMarksHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Студент"
                                                Binding="{Binding StudentName}"
                                                Width="260"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Группа"
                                                Binding="{Binding GroupName}"
                                                Width="110"
                                                IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Статус" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding #Root.DataContext.AttendanceStatuses}"
                                                  SelectedItem="{Binding Status}"
                                                  HorizontalAlignment="Stretch"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Комментарий"
                                                Binding="{Binding Comment}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ListBox ItemsSource="{Binding LessonMarks}"
                             IsVisible="{Binding #LessonMarksHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:AttendanceMarkItem">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GroupName}" Foreground="{DynamicResource AccentThemeBrush}"/>
                                    </Grid>
                                    <ComboBox Grid.Row="1"
                                              ItemsSource="{Binding #Root.DataContext.AttendanceStatuses}"
                                              SelectedItem="{Binding Status}"/>
                                    <TextBox Grid.Row="2"
                                             Watermark="Комментарий"
                                             Text="{Binding Comment}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleBackgroundBrush}"
                            IsVisible="{Binding LessonStudentCount, Converter={StaticResource NoDataConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Нет студентов" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Выберите занятие, где есть студенты группы."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
