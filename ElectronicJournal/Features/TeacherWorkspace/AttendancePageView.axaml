<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.AttendancePageView"
             x:Name="Root"
             x:DataType="vm:AttendancePageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="14"
                BorderBrush="{DynamicResource BorderThemeBrush}"
                BorderThickness="0"
                Background="Transparent">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Фильтры посещаемости"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Сбросить"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Content="Обновить"
                                Command="{Binding LoadCommand}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <ComboBox Width="220"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroupFilter}"
                              PlaceholderText="Группа">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Group">
                                <TextBlock Text="{Binding GroupName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Width="240"
                              ItemsSource="{Binding Subjects}"
                              SelectedItem="{Binding SelectedSubjectFilter}"
                              PlaceholderText="Предмет">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Subject">
                                <TextBlock Text="{Binding SubjectName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Width="170"
                             Watermark="Дата"
                             Text="{Binding DateFilter}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="12">
            <Border Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0" Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Записей" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding VisibleAttendanceCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0" Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Присутствовали" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding PresentCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0" Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Отсутствовали" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AbsentCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="10" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0" Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Опоздали" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding LateCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="300,*"
              ColumnSpacing="10">
            <Border Grid.Column="1" BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0" Background="Transparent">
                <Grid x:Name="AttendanceListHost" RowDefinitions="Auto,*">
                    <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Журнал посещаемости" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Нет данных" Foreground="{DynamicResource MutedTextBrush}" IsVisible="{Binding VisibleAttendanceCount, Converter={StaticResource NoDataConverter}}"/>
                    </Grid>
                    <DataGrid Grid.Row="1"
                              MinWidth="720"
                              ItemsSource="{Binding AttendanceItems}"
                              SelectedItem="{Binding SelectedAttendanceItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              IsVisible="{Binding #AttendanceListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding LessonDate}" Width="110"/>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="220"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="180"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            IsVisible="{Binding VisibleAttendanceCount, Converter={StaticResource NoDataConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Нет данных" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Отметьте посещаемость справа или измените фильтры."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AttendanceItems}"
                             SelectedItem="{Binding SelectedAttendanceItem}"
                             IsVisible="{Binding #AttendanceListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                    <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding SubjectName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LessonDate}" Foreground="{DynamicResource MutedTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Padding="12"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="10">
                    <TextBlock Text="Посещаемость"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <Border Padding="9"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0"
                            Background="Transparent">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding SelectedAttendanceTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedAttendanceDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedAttendanceComment}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Отметка"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerThemeBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ComboBox ItemsSource="{Binding Lessons}"
                              SelectedValue="{Binding SelectedLessonId}"
                              SelectedValueBinding="{Binding Id}"
                              PlaceholderText="Занятие">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Students}"
                              SelectedValue="{Binding SelectedStudentId}"
                              SelectedValueBinding="{Binding Id}"
                              PlaceholderText="Студент">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding AttendanceStatuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              PlaceholderText="Статус"/>

                    <TextBox Watermark="Комментарий"
                             Text="{Binding Comment}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Content="Сохранить"
                                Command="{Binding SaveAttendanceCommand}"/>
                        <Button Grid.Column="1"
                                Content="Удалить"
                                Command="{Binding DeleteSelectedAttendanceCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding ResultMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
