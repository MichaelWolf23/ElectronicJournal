<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElectronicJournal.ViewModels"
        xmlns:entities="using:ElectronicJournal.Models.Entities"
        x:Class="ElectronicJournal.Views.LoginWindow"
        x:DataType="vm:LoginWindowViewModel"
        Title="Вход"
        Width="520"
        Height="560"
        MinWidth="440"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Width="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Электронный журнал"
                                   FontSize="24"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Вход в систему"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding ThemeButtonText}"
                            VerticalAlignment="Top"
                            Command="{Binding ToggleThemeCommand}"/>
                </Grid>

                <TabControl Grid.Row="1">
                    <TabItem Header="Вход">
                        <StackPanel Spacing="12"
                                    Margin="0,18,0,0"
                                    IsEnabled="{Binding CanUseDatabase}">
                            <TextBox Watermark="Логин"
                                     Text="{Binding LoginUsername}"/>
                            <TextBox Watermark="Пароль"
                                     PasswordChar="*"
                                     Text="{Binding LoginPassword}"/>
                            <Button Content="Войти"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding LoginCommand}"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Регистрация">
                        <ScrollViewer MaxHeight="300"
                                      Margin="0,18,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="{Binding CanUseDatabase}">
                            <StackPanel Spacing="12">
                                <ComboBox ItemsSource="{Binding Roles}"
                                          SelectedValue="{Binding SelectedRoleId}"
                                          SelectedValueBinding="{Binding RoleId}"
                                          PlaceholderText="Роль">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Role">
                                            <TextBlock Text="{Binding RoleName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Watermark="ФИО"
                                         Text="{Binding FullName}"/>
                                <TextBox Watermark="Логин"
                                         Text="{Binding RegisterUsername}"/>
                                <TextBox Watermark="Пароль"
                                         PasswordChar="*"
                                         Text="{Binding RegisterPassword}"/>
                                <TextBox Watermark="Повторите пароль"
                                         PasswordChar="*"
                                         Text="{Binding RegisterPasswordRepeat}"/>
                                <TextBox Watermark="Email"
                                         Text="{Binding Email}"/>
                                <TextBox Watermark="Телефон"
                                         Text="{Binding Phone}"/>
                                <Button Content="Зарегистрироваться"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding RegisterCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="2"
                           Text="{Binding Message}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           MinHeight="38"/>
            </Grid>
        </Border>
    </Grid>
</Window>
