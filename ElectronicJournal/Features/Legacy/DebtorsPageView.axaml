<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.DebtorsPageView"
             x:DataType="vm:DebtorsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="10"
                BorderBrush="{DynamicResource BorderThemeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundBrush}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Задолженности"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="8"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleBackgroundBrush}">
                        <StackPanel>
                            <TextBlock Text="Проходной балл"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding MinPositiveGrade}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentThemeBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,180,180,130,130"
                      ColumnSpacing="10">
                    <TextBox Watermark="Поиск: студент, группа, предмет"
                             Text="{Binding SearchText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding GroupFilters}"
                              SelectedItem="{Binding SelectedGroupFilter}"
                              PlaceholderText="Группа"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SubjectFilters}"
                              SelectedItem="{Binding SelectedSubjectFilter}"
                              PlaceholderText="Предмет"/>
                    <Button Grid.Column="3"
                            Content="Сбросить"
                            Command="{Binding ClearFiltersCommand}"/>
                    <Button Grid.Column="4"
                            Content="Обновить"
                            Command="{Binding LoadCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="12">
            <Border Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Задолженностей"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding VisibleDebtCount}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Студентов"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding UniqueStudentCount}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Групп затронуто"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AffectedGroupCount}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Самая низкая"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding WorstGradeText}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="300,*"
              ColumnSpacing="10">
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="10,8,10,6"
                                Spacing="2">
                        <TextBlock Text="Список проблем"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Debtors}"
                              SelectedItem="{Binding SelectedDebtor}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="2*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                            <DataGridTemplateColumn Header="Оценка" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GradeValue}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding GradeValue, Converter={StaticResource GradeBrushConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding GradeDate}" Width="120"/>
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Padding="12"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Детали"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerThemeBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Border Padding="9"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleBackgroundBrush}">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding SelectedProblemTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedProblemDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedProblemComment}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Предпросмотр уведомления"
                               FontWeight="SemiBold"/>
                    <Border Padding="9"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{DynamicResource SubtleBackgroundBrush}">
                        <TextBlock Text="{Binding NotificationPreview}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>

                    <Button Content="Создать уведомление куратору"
                            Command="{Binding CreateNotificationCommand}"
                            IsVisible="{Binding CanCreateNotification}"/>

                    <TextBlock Text="В роли куратора этот раздел используется для контроля своих групп. Создание уведомлений доступно преподавателю и администратору."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               IsVisible="{Binding IsNotificationHelpVisible}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
