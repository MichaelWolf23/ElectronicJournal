<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.DebtorsPageView"
             x:Name="Root"
             x:DataType="vm:DebtorsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="10"
                BorderBrush="{DynamicResource BorderThemeBrush}"
                BorderThickness="0"
                Background="Transparent">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Задолженности"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResultMessage}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="8"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0"
                            Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="Проходной балл"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding MinPositiveGrade}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentThemeBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Width="280"
                                 Watermark="Поиск"
                                 Text="{Binding SearchText}"/>
                        <ComboBox Width="180"
                                  ItemsSource="{Binding GroupFilters}"
                                  SelectedItem="{Binding SelectedGroupFilter}"
                                  PlaceholderText="Группа"/>
                        <ComboBox Width="210"
                                  ItemsSource="{Binding SubjectFilters}"
                                  SelectedItem="{Binding SelectedSubjectFilter}"
                                  PlaceholderText="Предмет"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button Content="Сбросить"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Content="Обновить"
                                Command="{Binding LoadCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="12">
            <Border Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Задолженностей"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding VisibleDebtCount}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Студентов"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding UniqueStudentCount}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Групп затронуто"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AffectedGroupCount}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3"
                    Padding="10"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="4">
                    <TextBlock Text="Самая низкая"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding WorstGradeText}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="300,*"
              ColumnSpacing="10">
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <Grid x:Name="DebtorsListHost" RowDefinitions="Auto,*">
                    <StackPanel Margin="10,8,10,6"
                                Spacing="2">
                        <TextBlock Text="Список проблем"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              MinWidth="720"
                              ItemsSource="{Binding Debtors}"
                              SelectedItem="{Binding SelectedDebtor}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              IsVisible="{Binding #DebtorsListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="220"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="110"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="180"/>
                            <DataGridTemplateColumn Header="Оценка" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GradeValue}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding GradeValue, Converter={StaticResource GradeBrushConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Дата" Binding="{Binding GradeDate}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Debtors}"
                             SelectedItem="{Binding SelectedDebtor}"
                             IsVisible="{Binding #DebtorsListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                    <TextBlock Text="{Binding StudentName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GradeValue}" FontWeight="SemiBold" Foreground="{Binding GradeValue, Converter={StaticResource GradeBrushConverter}}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding SubjectName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GradeDate}" Foreground="{DynamicResource MutedTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Padding="12"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="12">
                    <TextBlock Text="Детали"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerThemeBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Border Padding="9"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0"
                            Background="Transparent">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding SelectedProblemTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedProblemDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedProblemComment}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Предпросмотр уведомления"
                               FontWeight="SemiBold"/>
                    <Border Padding="9"
                            BorderBrush="{DynamicResource BorderThemeBrush}"
                            BorderThickness="0"
                            Background="Transparent">
                        <TextBlock Text="{Binding NotificationPreview}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>

                    <Button Content="Уведомить куратора"
                            Command="{Binding CreateNotificationCommand}"
                            IsVisible="{Binding CanCreateNotification}"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
