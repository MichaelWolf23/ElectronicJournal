<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.SettingsPageView"
             x:Name="Root"
             x:DataType="vm:SettingsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Настройки системы" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Обновить" Classes="ghost" VerticalAlignment="Center" Command="{Binding LoadCommand}"/>
        </Grid>

        <Border Grid.Row="1" Classes="section-panel">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SettingCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="параметров" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding CurrentPeriod}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource SuccessThemeBrush}"/>
                    <TextBlock Text="текущий период" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding GradeScaleText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                    <TextBlock Text="шкала оценок" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,340" ColumnSpacing="18">
            <Border x:Name="SettingsListHost" Classes="section-panel">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Параметры журнала" FontSize="18" FontWeight="SemiBold"/>
                <DataGrid Grid.Row="1" Margin="0,10,0,0" MinWidth="660" ItemsSource="{Binding Settings}" SelectedItem="{Binding SelectedSetting}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" IsVisible="{Binding #SettingsListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding SettingKey}" Width="220"/>
                        <DataGridTextColumn Header="Значение" Binding="{Binding SettingValue}" Width="170"/>
                        <DataGridTextColumn Header="Где работает" Binding="{Binding AppliesTo}" Width="260"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Settings}" SelectedItem="{Binding SelectedSetting}" IsVisible="{Binding #SettingsListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="Auto,Auto" Margin="0,5">
                                <TextBlock Text="{Binding SettingKey}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{Binding AppliesTo}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            </Border>

            <Border Grid.Column="1" Classes="side-panel">
                <ScrollViewer>
                <StackPanel Spacing="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Изменить настройку" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerThemeBrush}" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <TextBlock Text="Параметр" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedSetting.SettingKey}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Где применяется" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedSetting.AppliesTo}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedSetting.Description}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                        <TextBox Watermark="Значение" Text="{Binding SettingValue}"/>
                        <Button Content="Сохранить" Classes="primary" Command="{Binding SaveCommand}"/>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource BorderThemeBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Резерв и архив" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding BackupResultMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Content="Резервная копия" Classes="success" Command="{Binding CreateBackupCommand}"/>
                                <Button Grid.Column="1" Content="Архив" Classes="warning" Command="{Binding ArchiveSemesterCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
