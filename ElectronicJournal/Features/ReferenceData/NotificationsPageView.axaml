<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.NotificationsPageView"
             x:Name="Root"
             x:DataType="vm:NotificationsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Classes="toolbar-panel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Уведомления" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InboxSummary}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Обновить"
                            Classes="ghost"
                            Command="{Binding LoadCommand}"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBox Watermark="Поиск по студенту, группе или тексту"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1"
                              Width="170"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"/>
                    <Button Grid.Column="2"
                            Content="Сбросить"
                            Classes="ghost"
                            Command="{Binding ClearFiltersCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
            <UniformGrid Columns="4">
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding NewCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DangerThemeBrush}"/>
                    <TextBlock Text="новые" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding ReadCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="прочитано" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding ClosedCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                    <TextBlock Text="закрыто" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding VisibleNotificationCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="показано" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2" x:Name="InboxHost">
            <Grid ColumnDefinitions="*,360"
                  ColumnSpacing="14"
                  IsVisible="{Binding #InboxHost.Bounds.Width, Converter={StaticResource WideDashboardConverter}}">
                <Border Classes="section-panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Входящие" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Выберите сообщение и обработайте статус справа."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VisibleNotificationCount, StringFormat='{}{0} сообщений'}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Notifications}"
                                     SelectedItem="{Binding SelectedNotification}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="dto:CuratorNotificationItem">
                                        <Border Classes="list-row">
                                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="12">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1"
                                                        Padding="8,4"
                                                        CornerRadius="10"
                                                        Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding StudentName}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding GroupName}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding CreatedAt}"
                                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{DynamicResource SubtleBackgroundBrush}"
                                    IsVisible="{Binding VisibleNotificationCount, Converter={StaticResource NoDataConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="Нет уведомлений" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Измените фильтр или дождитесь новых сообщений от преподавателей."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="section-panel">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedNotificationTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedNotificationDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding SelectedNotificationMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Border>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <TextBlock Text="Статус" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Content="Новое"
                                        Classes="warning"
                                        Command="{Binding MarkAsNewCommand}"/>
                                <Button Grid.Column="1"
                                        Content="Прочитано"
                                        Classes="primary"
                                        Command="{Binding MarkAsReadCommand}"/>
                                <Button Grid.Column="2"
                                        Content="Закрыто"
                                        Classes="success"
                                        Command="{Binding MarkAsClosedCommand}"/>
                            </Grid>
                            <Button Content="Удалить уведомление"
                                    Classes="danger"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteSelectedNotificationCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding #InboxHost.Bounds.Width, Converter={StaticResource CompactDashboardConverter}}">
                <StackPanel Spacing="14">
                    <Border Classes="section-panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding SelectedNotificationTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedNotificationMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="Прочитано" Margin="0,0,8,8" Classes="primary" Command="{Binding MarkAsReadCommand}"/>
                                <Button Content="Закрыто" Margin="0,0,8,8" Classes="success" Command="{Binding MarkAsClosedCommand}"/>
                                <Button Content="Удалить" Margin="0,0,0,8" Classes="danger" Command="{Binding DeleteSelectedNotificationCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="section-panel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="Входящие" FontSize="18" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}" SelectedItem="{Binding SelectedNotification}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="dto:CuratorNotificationItem">
                                        <Border Classes="list-row">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="1" Text="{Binding StudentName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedAt}" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
