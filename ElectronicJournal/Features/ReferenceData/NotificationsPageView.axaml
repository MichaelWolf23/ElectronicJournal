<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.NotificationsPageView"
             x:Name="Root"
             x:DataType="vm:NotificationsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Classes="toolbar-panel">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="Центр уведомлений"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBox Grid.Column="1"
                         Width="250"
                         Watermark="Поиск"
                         Text="{Binding SearchText}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="190"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              PlaceholderText="Статус"/>
                    <Button Content="Обновить"
                            Classes="ghost"
                            Command="{Binding LoadCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
        <Grid ColumnDefinitions="*,*,*,*"
              ColumnSpacing="10">
            <Border Classes="metric-panel">
                <StackPanel>
                    <TextBlock Text="Новые"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding NewCount}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Classes="metric-panel">
                <StackPanel>
                    <TextBlock Text="Прочитано"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ReadCount}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Classes="metric-panel">
                <StackPanel>
                    <TextBlock Text="Закрыто"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding ClosedCount}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Classes="metric-panel">
                <StackPanel>
                    <TextBlock Text="Показано"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding VisibleNotificationCount}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="300,*"
              ColumnSpacing="12">
            <Border Grid.Column="1" Classes="section-panel">
                <Grid x:Name="NotificationsListHost" RowDefinitions="Auto,*">
                    <StackPanel Margin="0,0,0,10" Spacing="2">
                        <TextBlock Text="Лента уведомлений" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              MinWidth="720"
                              ItemsSource="{Binding Notifications}"
                              SelectedItem="{Binding SelectedNotification}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              IsVisible="{Binding #NotificationsListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>
                            <DataGridTextColumn Header="Куратор" Binding="{Binding CuratorName}" Width="180"/>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="180"/>
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="210"/>
                            <DataGridTemplateColumn Header="Статус" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Notifications}"
                             SelectedItem="{Binding SelectedNotification}"
                             IsVisible="{Binding #NotificationsListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                                    <TextBlock Grid.Row="1" Text="{Binding StudentName}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedAt}" Foreground="{DynamicResource MutedTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Classes="side-panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Уведомление" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerThemeBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Border Padding="12"
                            CornerRadius="6"
                            Background="{DynamicResource SubtleBackgroundBrush}">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{Binding SelectedNotificationTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedNotificationDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedNotificationMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Изменить статус" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Content="Новое"
                                Classes="warning"
                                Command="{Binding MarkAsNewCommand}"/>
                        <Button Grid.Column="1"
                                Content="Прочитано"
                                Classes="primary"
                                Command="{Binding MarkAsReadCommand}"/>
                        <Button Grid.Column="2"
                                Content="Закрыто"
                                Classes="success"
                                Command="{Binding MarkAsClosedCommand}"/>
                    </Grid>
                    <Button Content="Удалить уведомление"
                            Classes="danger"
                            HorizontalAlignment="Left"
                            Command="{Binding DeleteSelectedNotificationCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
