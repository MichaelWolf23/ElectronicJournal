<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:entities="using:ElectronicJournal.Models.Entities"
             x:Class="ElectronicJournal.Views.GroupsPageView"
             x:Name="Root"
             x:DataType="vm:GroupsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Classes="toolbar-panel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Группы" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Обновить"
                        Classes="ghost"
                        Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-panel">
            <UniformGrid Columns="3">
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding GroupCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentThemeBrush}"/>
                    <TextBlock Text="всего групп" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2" Margin="0,0,14,0">
                    <TextBlock Text="{Binding FirstCourseCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource SuccessThemeBrush}"/>
                    <TextBlock Text="первый курс" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SeniorCourseCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource WarningThemeBrush}"/>
                    <TextBlock Text="старшие курсы" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2" x:Name="GroupsAdminHost">
            <Grid ColumnDefinitions="*,340"
                  ColumnSpacing="14"
                  IsVisible="{Binding #GroupsAdminHost.Bounds.Width, Converter={StaticResource WideDashboardConverter}}">
                <Border Classes="section-panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Список групп" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Выберите группу, чтобы изменить курс или описание."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GroupCount, StringFormat='{}{0} групп'}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Group">
                                        <Border Classes="list-row">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="10">
                                                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CourseNumber, StringFormat='{}{0} курс'}"
                                                           Foreground="{DynamicResource AccentThemeBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding Description}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{DynamicResource SubtleBackgroundBrush}"
                                    IsVisible="{Binding GroupCount, Converter={StaticResource NoDataConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="Нет групп" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Создайте первую учебную группу справа."
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="section-panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource SubtleBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderThemeBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <TextBlock Text="Группу можно удалить только если в ней нет студентов и назначенных предметов."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBox Watermark="Название группы" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Watermark="Курс от 1 до 6" Text="{Binding CourseNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Watermark="Описание" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Content="Сохранить" Classes="primary" Command="{Binding SaveCommand}"/>
                            <Button Grid.Column="1" Content="Новая" Classes="ghost" Command="{Binding ClearFormCommand}"/>
                        </Grid>
                        <Button Content="Удалить группу"
                                Classes="danger"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DeleteSelectedGroupCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding #GroupsAdminHost.Bounds.Width, Converter={StaticResource CompactDashboardConverter}}">
                <StackPanel Spacing="14">
                    <Border Classes="section-panel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Text="Список групп" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GroupCount, StringFormat='{}{0} групп'}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ListBox Grid.Row="1" MaxHeight="320" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Group">
                                        <Border Classes="list-row">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="10">
                                                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CourseNumber, StringFormat='{}{0} курс'}"
                                                           Foreground="{DynamicResource AccentThemeBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding Description}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Classes="section-panel">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBox Watermark="Название группы" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Watermark="Курс от 1 до 6" Text="{Binding CourseNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Watermark="Описание" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Content="Сохранить" Classes="primary" Command="{Binding SaveCommand}"/>
                                <Button Grid.Column="1" Content="Новая" Classes="ghost" Command="{Binding ClearFormCommand}"/>
                            </Grid>
                            <Button Content="Удалить группу"
                                    Classes="danger"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteSelectedGroupCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
