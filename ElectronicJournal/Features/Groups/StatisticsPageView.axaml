<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.StatisticsPageView"
             x:Name="Root"
             x:DataType="vm:StatisticsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="10"
                BorderBrush="{DynamicResource BorderThemeBrush}"
                BorderThickness="0"
                Background="Transparent">
            <Grid ColumnDefinitions="*,170" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="Аналитика групп"
                               FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Обновить"
                        Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*,*"
              ColumnSpacing="12">
            <Border Padding="14"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Студентов"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalStudents}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="14"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Средний балл"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F2}}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Должников"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding TotalDebtors}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Padding="14"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Порог"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding MinPositiveGrade}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Padding="14"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Групп с риском"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding RiskGroupCount}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="5"
                    Padding="14"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel>
                    <TextBlock Text="Лучшая группа"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding BestGroupText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SuccessThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,300"
              ColumnSpacing="10">
            <Border BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <Grid x:Name="StatisticsListHost" RowDefinitions="Auto,*">
                    <StackPanel Margin="16,14,16,10" Spacing="2">
                        <TextBlock Text="Группы и успеваемость" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerThemeBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              MinWidth="560"
                              ItemsSource="{Binding GroupStatistics}"
                              SelectedItem="{Binding SelectedGroupStatistics}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              IsVisible="{Binding #StatisticsListHost.Bounds.Width, Converter={StaticResource WideTableConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="180"/>
                            <DataGridTextColumn Header="Студентов" Binding="{Binding StudentCount}" Width="110"/>
                            <DataGridTextColumn Header="Средний балл" Binding="{Binding AverageGrade, StringFormat={}{0:F2}}" Width="130"/>
                            <DataGridTextColumn Header="Должников" Binding="{Binding DebtorCount}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding GroupStatistics}" SelectedItem="{Binding SelectedGroupStatistics}" IsVisible="{Binding #StatisticsListHost.Bounds.Width, Converter={StaticResource CompactTableConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,5" ColumnSpacing="10">
                                    <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AverageGrade, StringFormat={}{0:F2}}" Foreground="{DynamicResource SuccessThemeBrush}" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Студентов:" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding StudentCount}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Долги:" Foreground="{DynamicResource DangerThemeBrush}"/>
                                        <TextBlock Text="{Binding DebtorCount}" Foreground="{DynamicResource DangerThemeBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    BorderBrush="{DynamicResource BorderThemeBrush}"
                    BorderThickness="0"
                    Background="Transparent">
                <StackPanel Spacing="12">
                    <TextBlock Text="Анализ выбранной группы"
                               FontSize="19"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedGroupTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedGroupDetails}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding SelectedGroupRisk}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningThemeBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
