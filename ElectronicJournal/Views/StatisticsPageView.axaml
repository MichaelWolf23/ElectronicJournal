<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.StatisticsPageView"
             x:DataType="vm:StatisticsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,170" ColumnSpacing="10">
            <StackPanel>
                <TextBlock Text="Статистика групп"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="#57606A"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="12">
            <Border Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Студентов"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding TotalStudents}"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Средний балл"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding AverageGrade, StringFormat={}{0:F2}}"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Должников"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding TotalDebtors}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#B42318"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Порог"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding MinPositiveGrade}"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding GroupStatistics}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="2*"/>
                    <DataGridTextColumn Header="Студентов" Binding="{Binding StudentCount}" Width="*"/>
                    <DataGridTextColumn Header="Средний балл" Binding="{Binding AverageGrade, StringFormat={}{0:F2}}" Width="*"/>
                    <DataGridTextColumn Header="Должников" Binding="{Binding DebtorCount}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
