<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.LessonsPageView"
             x:DataType="vm:LessonsPageViewModel">
    <Grid RowDefinitions="*,Auto" RowSpacing="14">
        <TabControl>
            <TabItem Header="Занятия">
                <DataGrid ItemsSource="{Binding Lessons}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#D0D7DE"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding LessonDate}" Width="110"/>
                        <DataGridTextColumn Header="Тема" Binding="{Binding Topic}" Width="2*"/>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                        <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                        <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomName}" Width="*"/>
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Расписание">
                <DataGrid ItemsSource="{Binding Schedule}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="#D0D7DE"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                        <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                        <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                        <DataGridTextColumn Header="День недели" Binding="{Binding DayOfWeek}" Width="110"/>
                        <DataGridTextColumn Header="Начало" Binding="{Binding StartTime}" Width="100"/>
                        <DataGridTextColumn Header="Конец" Binding="{Binding EndTime}" Width="100"/>
                        <DataGridTextColumn Header="Аудитория" Binding="{Binding ClassroomName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Padding="16"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                Background="#FFFFFF">
            <Grid ColumnDefinitions="2*,140,*,*,2*,160" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding Assignments}"
                          SelectedValue="{Binding SelectedAssignmentId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Группа - предмет - преподаватель">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="1"
                         Watermark="Дата"
                         Text="{Binding LessonDate}"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding Classrooms}"
                          SelectedValue="{Binding SelectedClassroomId}"
                          SelectedValueBinding="{Binding Id}"
                          PlaceholderText="Аудитория">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="dto:LookupItem">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="3"
                         Watermark="Тема"
                         Text="{Binding Topic}"/>
                <TextBox Grid.Column="4"
                         Watermark="Примечание"
                         Text="{Binding Note}"/>
                <Button Grid.Column="5"
                        Content="Добавить занятие"
                        Command="{Binding AddLessonCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
