<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.FinalGradesPageView"
             x:DataType="vm:FinalGradesPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,150" ColumnSpacing="10">
            <StackPanel>
                <TextBlock Text="Итоговые оценки"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="#57606A"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,350"
              ColumnSpacing="16">
            <DataGrid ItemsSource="{Binding FinalGrades}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                    <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                    <DataGridTextColumn Header="Период" Binding="{Binding PeriodName}" Width="*"/>
                    <DataGridTextColumn Header="Средний" Binding="{Binding CalculatedAverage, StringFormat={}{0:F2}}" Width="90"/>
                    <DataGridTemplateColumn Header="Итог" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FinalValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding FinalValue, Converter={StaticResource GradeBrushConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="2*"/>
                    <DataGridTextColumn Header="Утверждено" Binding="{Binding ApprovedAt}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Padding="18"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel Spacing="10">
                    <TextBlock Text="Рассчитать итог"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ComboBox ItemsSource="{Binding Students}"
                              SelectedValue="{Binding SelectedStudentId}"
                              SelectedValueBinding="{Binding Id}"
                              PlaceholderText="Студент">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Assignments}"
                              SelectedValue="{Binding SelectedAssignmentId}"
                              SelectedValueBinding="{Binding Id}"
                              PlaceholderText="Группа — предмет — преподаватель">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Periods}"
                              SelectedValue="{Binding SelectedPeriodId}"
                              SelectedValueBinding="{Binding Id}"
                              PlaceholderText="Период">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:LookupItem">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding CalculatedAverage, StringFormat=Средний балл: {0:F2}}"
                               TextWrapping="Wrap"/>
                    <Button Content="Рассчитать средний"
                            Command="{Binding CalculateCommand}"/>

                    <TextBox Watermark="Итоговая оценка"
                             Text="{Binding FinalValue}"/>
                    <TextBox Watermark="Комментарий преподавателя"
                             Text="{Binding Comment}"/>

                    <Button Content="Сохранить итог"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
