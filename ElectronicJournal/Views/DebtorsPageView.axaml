<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.DebtorsPageView"
             x:DataType="vm:DebtorsPageViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,170,190" ColumnSpacing="10">
            <StackPanel>
                <TextBlock Text="Должники"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="#57606A"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="12"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Минимальная оценка"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding MinPositiveGrade}"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Content="Обновить список"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Debtors}"
                  SelectedItem="{Binding SelectedDebtor}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#D0D7DE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="2*"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding GradeValue}" Width="90"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding GradeDate}" Width="120"/>
                <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Padding="14"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                Background="#FFFFFF">
            <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="Выберите студента с задолженностью и создайте уведомление куратору группы."
                               Foreground="#57606A"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Создать уведомление"
                        Command="{Binding CreateNotificationCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
