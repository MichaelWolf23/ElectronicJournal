<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             x:Class="ElectronicJournal.Views.PlaceholderPageView"
             x:DataType="vm:PlaceholderPageViewModel">
    <Border Padding="24"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="8"
            Background="#FAFBFC">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       Foreground="#555555"/>
        </StackPanel>
    </Border>
</UserControl>
