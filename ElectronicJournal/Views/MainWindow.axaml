<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElectronicJournal.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="ElectronicJournal.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Электронный журнал"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="460">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Spacing="6">
            <TextBlock Text="Электронный журнал"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding DatabaseStatus}"
                       FontSize="15"
                       Foreground="#666666"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,22,0,0"
              ColumnDefinitions="220,*"
              ColumnSpacing="18">
            <Border Padding="12"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FAFBFC">
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       Margin="8"
                                       FontSize="15"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
                <Border Padding="14"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#FFFFFF">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DatabasePath}"
                                   TextWrapping="Wrap"
                                   Foreground="#444444"/>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Доступность:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding IsDatabaseAvailable}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Таблиц:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TableCount}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
