<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ElectronicJournal.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="ElectronicJournal.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Электронный журнал"
        Width="1200"
        Height="750"
        MinWidth="980"
        MinHeight="620">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="#F6F8FA">
        <Border Grid.Row="0"
                Padding="24,18"
                Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel Spacing="4">
                    <TextBlock Text="Электронный журнал"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DatabaseStatus}"
                               FontSize="14"
                               Foreground="#57606A"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="Текущий период"
                               Foreground="#57606A"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding CurrentPeriodName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="24"
              ColumnDefinitions="230,*"
              ColumnSpacing="18">
            <Border Padding="12"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Разделы"
                               Margin="8,4,8,12"
                               FontWeight="SemiBold"
                               Foreground="#24292F"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           Margin="8"
                                           FontSize="15"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
                <Border Padding="14"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="#FFFFFF">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Text="{Binding DatabasePath}"
                                   TextWrapping="Wrap"
                                   Foreground="#444444"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="18"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="База:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding IsDatabaseAvailable}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Таблиц:" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TableCount}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentPage}"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="24,10"
                Background="#FFFFFF"
                BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding OperationStatus}"
                       Foreground="#57606A"/>
        </Border>
    </Grid>
</Window>
