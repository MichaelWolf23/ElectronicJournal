<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.NotificationsPageView"
             x:DataType="vm:NotificationsPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,190,150" ColumnSpacing="10">
            <StackPanel>
                <TextBlock Text="Уведомления"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="#57606A"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter}"
                      PlaceholderText="Статус"/>

            <Button Grid.Column="2"
                    Content="Обновить"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="12">
            <Border Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Новые"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding NewCount}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="#B42318"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Прочитано"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding ReadCount}"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel>
                    <TextBlock Text="Закрыто"
                               Foreground="#57606A"/>
                    <TextBlock Text="{Binding ClosedCount}"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Notifications}"
                  SelectedItem="{Binding SelectedNotification}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#D0D7DE"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="150"/>
                <DataGridTextColumn Header="Куратор" Binding="{Binding CuratorName}" Width="2*"/>
                <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="2*"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Текст" Binding="{Binding Message}" Width="3*"/>
                <DataGridTemplateColumn Header="Статус" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Прочитано" Binding="{Binding ReadAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Padding="14"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="8"
                Background="#FFFFFF">
            <Grid ColumnDefinitions="*,120,120,120" ColumnSpacing="10">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="Выберите уведомление и измените его статус."
                               Foreground="#57606A"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Новое"
                        Command="{Binding MarkAsNewCommand}"/>
                <Button Grid.Column="2"
                        Content="Прочитано"
                        Command="{Binding MarkAsReadCommand}"/>
                <Button Grid.Column="3"
                        Content="Закрыто"
                        Command="{Binding MarkAsClosedCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
