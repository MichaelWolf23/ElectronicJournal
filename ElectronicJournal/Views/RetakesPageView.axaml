<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElectronicJournal.ViewModels"
             xmlns:dto="using:ElectronicJournal.Models.Dto"
             x:Class="ElectronicJournal.Views.RetakesPageView"
             x:DataType="vm:RetakesPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,140" ColumnSpacing="10">
            <TextBlock Text="История пересдач"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,360"
              ColumnSpacing="16">
            <DataGrid ItemsSource="{Binding Retakes}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="#D0D7DE"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="2*"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                    <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*"/>
                    <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="2*"/>
                    <DataGridTemplateColumn Header="Старая" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OldValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding OldValue, Converter={StaticResource GradeBrushConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Новая" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NewValue}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding NewValue, Converter={StaticResource GradeBrushConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата" Binding="{Binding RetakeDate}" Width="110"/>
                    <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*"/>
                    <DataGridTextColumn Header="Изменил" Binding="{Binding ChangedByName}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Padding="18"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="#FFFFFF">
                <StackPanel Spacing="10">
                    <TextBlock Text="Добавить пересдачу"
                               FontSize="19"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#B42318"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <ComboBox ItemsSource="{Binding Grades}"
                              SelectedItem="{Binding SelectedGrade}"
                              PlaceholderText="Оценка для пересдачи">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:GradeJournalItem">
                                <TextBlock Text="{Binding StudentName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Текущая оценка:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OldValue}"/>
                    </StackPanel>

                    <TextBox Watermark="Новая оценка"
                             Text="{Binding NewValue}"/>
                    <TextBox Watermark="Дата пересдачи, например 2026-02-20"
                             Text="{Binding RetakeDate}"/>
                    <TextBox Watermark="Причина"
                             Text="{Binding Reason}"/>

                    <Button Content="Сохранить пересдачу"
                            Command="{Binding AddRetakeCommand}"/>

                    <TextBlock Text="{Binding ResultMessage}"
                               TextWrapping="Wrap"
                               Foreground="#57606A"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
